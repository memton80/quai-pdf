<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>QuaiPdf.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- PDFium natif pour lancer les tests du texte sous Linux (le paquet Windows vient de QuaiPdf.Core). -->
    <PackageReference Include="bblanchon.PDFium.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuaiPdf.Core\QuaiPdf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
