<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuaiPdf.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:QuaiPdf.App.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (zone de glissement de la fenêtre). -->
        <Grid x:Name="AppTitleBar" Height="48">
            <StackPanel Style="{StaticResource TitleBarPanelStyle}">
                <Image Source="ms-appx:///Assets/AppIcon.png" Style="{StaticResource TitleBarIconStyle}" />
                <TextBlock Style="{StaticResource TitleBarTextStyle}" Text="{x:Bind Document.WindowTitle, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <views:DocumentView x:Name="DocumentHost" Grid.Row="1" />
    </Grid>
</Window>
