<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="QuaiPdf.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:QuaiPdf.App.Localization"
    xmlns:ui="using:QuaiPdf.App"
    Title="{l:Str Key=Settings_Title}"
    CloseButtonText="{l:Str Key=Common_Close}"
    DefaultButton="Close">

    <StackPanel Style="{StaticResource DialogFormStyle}">
        <RadioButtons Header="{l:Str Key=Settings_Theme}" SelectedIndex="{x:Bind Settings.ThemeIndex, Mode=TwoWay}">
            <RadioButton Content="{l:Str Key=Settings_ThemeSystem}" />
            <RadioButton Content="{l:Str Key=Settings_ThemeLight}" />
            <RadioButton Content="{l:Str Key=Settings_ThemeDark}" />
        </RadioButtons>
        <ToggleSwitch Header="{l:Str Key=Settings_Thumbnails}" IsOn="{x:Bind Settings.ShowThumbnails, Mode=TwoWay}" />
        <TextBlock Style="{StaticResource DialogHintStyle}" Text="{x:Bind ui:UiHelpers.VersionText(Settings.Version)}" />
        <TextBlock Style="{StaticResource DialogHintStyle}" Text="{x:Bind Settings.DataDirectory}" />
        <HyperlinkButton Click="OnOpenLogsClick" Content="{l:Str Key=Settings_OpenLogs}" />
    </StackPanel>
</ContentDialog>
