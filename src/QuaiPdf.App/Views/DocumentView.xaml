<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuaiPdf.App.Views.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:QuaiPdf.App.Localization"
    xmlns:ui="using:QuaiPdf.App"
    xmlns:views="using:QuaiPdf.App.Views"
    xmlns:vm="using:QuaiPdf.Core.ViewModels"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre d'outils : les raccourcis clavier sont posés dans le code (DocumentView.xaml.cs). -->
        <CommandBar x:Name="Toolbar" Style="{StaticResource ToolbarStyle}">
            <AppBarButton
                Command="{x:Bind ViewModel.OpenCommand}"
                Label="{l:Str Key=Toolbar_Open}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_OpenTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.SaveCommand}"
                Label="{l:Str Key=Toolbar_Save}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_SaveTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.UndoCommand}"
                Label="{l:Str Key=Toolbar_Undo}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_UndoTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7A7;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.RedoCommand}"
                Label="{l:Str Key=Toolbar_Redo}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_RedoTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7A6;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.RotateLeftCommand}"
                Label="{l:Str Key=Toolbar_RotateLeft}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_RotateLeftTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7AD;" Style="{StaticResource MirroredIconStyle}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.RotateRightCommand}"
                Label="{l:Str Key=Toolbar_RotateRight}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_RotateRightTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7AD;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.MoveUpCommand}"
                Label="{l:Str Key=Toolbar_MoveUp}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_MoveUpTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74A;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.MoveDownCommand}"
                Label="{l:Str Key=Toolbar_MoveDown}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_MoveDownTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74B;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.DeleteCommand}"
                Label="{l:Str Key=Toolbar_Delete}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_DeleteTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.InsertCommand}"
                Label="{l:Str Key=Toolbar_Insert}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_InsertTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.ExtractCommand}"
                Label="{l:Str Key=Toolbar_Extract}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_ExtractTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.PreviousPageCommand}"
                Label="{l:Str Key=Toolbar_PreviousPage}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_PreviousPage}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <StackPanel Style="{StaticResource ToolbarGroupStyle}">
                    <NumberBox
                        x:Name="PageBox"
                        AutomationProperties.Name="{l:Str Key=Toolbar_PageNumber}"
                        IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                        Maximum="{x:Bind ui:UiHelpers.PageMaximum(ViewModel.PageCount), Mode=OneWay}"
                        Style="{StaticResource PageNumberBoxStyle}"
                        ValueChanged="OnPageBoxValueChanged"
                        Value="{x:Bind ui:UiHelpers.ToDouble(ViewModel.CurrentPageNumber), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="{x:Bind ui:UiHelpers.PageCountText(ViewModel.PageCount), Mode=OneWay}" />
                </StackPanel>
            </AppBarElementContainer>
            <AppBarButton
                Command="{x:Bind ViewModel.NextPageCommand}"
                Label="{l:Str Key=Toolbar_NextPage}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_NextPage}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.ZoomOutCommand}"
                Label="{l:Str Key=Toolbar_ZoomOut}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_ZoomOutTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71F;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <DropDownButton
                    AutomationProperties.Name="{l:Str Key=Toolbar_Zoom}"
                    Content="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                    Style="{StaticResource ZoomButtonStyle}">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.FitWidthCommand}" Text="{l:Str Key=Zoom_FitWidth}" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ActualSizeCommand}" Text="{l:Str Key=Zoom_ActualSize}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Click="OnZoomPresetClick"
                                Tag="0.5"
                                Text="50 %" />
                            <MenuFlyoutItem
                                Click="OnZoomPresetClick"
                                Tag="0.75"
                                Text="75 %" />
                            <MenuFlyoutItem
                                Click="OnZoomPresetClick"
                                Tag="1.25"
                                Text="125 %" />
                            <MenuFlyoutItem
                                Click="OnZoomPresetClick"
                                Tag="1.5"
                                Text="150 %" />
                            <MenuFlyoutItem
                                Click="OnZoomPresetClick"
                                Tag="2"
                                Text="200 %" />
                            <MenuFlyoutItem
                                Click="OnZoomPresetClick"
                                Tag="3"
                                Text="300 %" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </AppBarElementContainer>
            <AppBarButton
                Command="{x:Bind ViewModel.ZoomInCommand}"
                Label="{l:Str Key=Toolbar_ZoomIn}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_ZoomInTooltip}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A3;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarToggleButton
                IsChecked="{x:Bind Settings.ShowThumbnails, Mode=TwoWay}"
                Label="{l:Str Key=Toolbar_Thumbnails}"
                ToolTipService.ToolTip="{l:Str Key=Toolbar_Thumbnails}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8A9;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton Command="{x:Bind ViewModel.CopyTextCommand}" Label="{l:Str Key=Text_Copy}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{x:Bind ViewModel.SelectAllTextCommand}" Label="{l:Str Key=Text_SelectAll}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8B3;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Command="{x:Bind ViewModel.SaveAsCommand}" Label="{l:Str Key=Toolbar_SaveAs}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE792;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{x:Bind ViewModel.EditPropertiesCommand}" Label="{l:Str Key=Toolbar_Properties}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{x:Bind ViewModel.CloseDocumentCommand}" Label="{l:Str Key=Toolbar_Close}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Click="OnSettingsClick" Label="{l:Str Key=Toolbar_Settings}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- Opération en cours, puis document en lecture seule. -->
        <StackPanel Grid.Row="1">
            <ProgressBar
                AutomationProperties.Name="{l:Str Key=Document_Busy}"
                Style="{StaticResource BusyBarStyle}"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(ViewModel.IsBusy), Mode=OneWay}" />
            <InfoBar
                x:Name="ReadOnlyBar"
                IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                Message="{x:Bind ViewModel.ReadOnlyMessage, Mode=OneWay}"
                Severity="Informational"
                Style="{StaticResource DocumentInfoBarStyle}"
                Title="{l:Str Key=Document_ReadOnlyTitle}"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(ViewModel.IsReadOnly), Mode=OneWay}" />
        </StackPanel>

        <!-- Aucun document ouvert. -->
        <StackPanel
            Grid.Row="2"
            Style="{StaticResource EmptyStatePanelStyle}"
            Visibility="{x:Bind ui:UiHelpers.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE8A5;" Style="{StaticResource EmptyStateIconStyle}" />
            <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="{l:Str Key=Empty_Title}" />
            <TextBlock Style="{StaticResource EmptyStateHintStyle}" Text="{l:Str Key=Empty_Hint}" />
            <Button
                Command="{x:Bind ViewModel.OpenCommand}"
                Content="{l:Str Key=Empty_Open}"
                Style="{StaticResource EmptyStateButtonStyle}" />
        </StackPanel>

        <!-- Document : vignettes à gauche, pages à droite. -->
        <Grid Grid.Row="2" Visibility="{x:Bind ui:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="Thumbnails"
                AllowDrop="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                AutomationProperties.Name="{l:Str Key=Thumbnails_Name}"
                CanDragItems="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                CanReorderItems="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                ContainerContentChanging="OnThumbnailContainerContentChanging"
                DragItemsCompleted="OnThumbnailsDragItemsCompleted"
                DragItemsStarting="OnThumbnailsDragItemsStarting"
                ItemsSource="{x:Bind ViewModel.Pages}"
                KeyDown="OnThumbnailsKeyDown"
                SelectionChanged="OnThumbnailsSelectionChanged"
                Style="{StaticResource ThumbnailsListStyle}"
                Visibility="{x:Bind ui:UiHelpers.VisibleIf(Settings.ShowThumbnails), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageItemViewModel">
                        <StackPanel Style="{StaticResource ThumbnailItemStyle}">
                            <Border Height="{x:Bind ThumbnailHeight, Mode=OneWay}" Style="{StaticResource ThumbnailBorderStyle}">
                                <Image Stretch="Fill" />
                            </Border>
                            <TextBlock Style="{StaticResource ThumbnailLabelStyle}" Text="{x:Bind Label, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1" Style="{StaticResource ReaderSurfaceStyle}">
                <ScrollViewer
                    x:Name="Scroller"
                    AutomationProperties.Name="{l:Str Key=Reader_Name}"
                    KeyDown="OnScrollerKeyDown"
                    Style="{StaticResource ReaderScrollViewerStyle}"
                    ViewChanged="OnScrollerViewChanged">
                    <ScrollViewer.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CopyTextCommand}" Text="{l:Str Key=Text_Copy}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.SelectAllTextCommand}" Text="{l:Str Key=Text_SelectAll}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </ScrollViewer.ContextFlyout>
                    <ItemsRepeater
                        x:Name="PagesRepeater"
                        Margin="{StaticResource ReaderPadding}"
                        HorizontalAlignment="Center"
                        ElementClearing="OnPageElementClearing"
                        ElementIndexChanged="OnPageElementIndexChanged"
                        ElementPrepared="OnPageElementPrepared"
                        ItemsSource="{x:Bind ViewModel.Pages}"
                        DoubleTapped="OnPagesDoubleTapped"
                        PointerCaptureLost="OnPagesPointerReleased"
                        PointerMoved="OnPagesPointerMoved"
                        PointerPressed="OnPagesPointerPressed"
                        PointerReleased="OnPagesPointerReleased">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="{StaticResource PageSpacing}" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageItemViewModel">
                                <Border
                                    Width="{x:Bind DisplayWidth, Mode=OneWay}"
                                    Height="{x:Bind DisplayHeight, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ui:UiHelpers.PageName(Number), Mode=OneWay}"
                                    Style="{StaticResource PageBorderStyle}">
                                    <!-- Image de la page, puis surlignage du texte sélectionné (repère à 100 %, mis à l'échelle). -->
                                    <views:TextPageSurface>
                                        <Image Stretch="Fill" />
                                        <Viewbox Style="{StaticResource TextLayerStyle}">
                                            <Canvas Width="{x:Bind BaseWidth, Mode=OneWay}" Height="{x:Bind BaseHeight, Mode=OneWay}" />
                                        </Viewbox>
                                    </views:TextPageSurface>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
